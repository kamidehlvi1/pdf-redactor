
# Secret Key for Flask Session Security
SECRET_KEY=change-this-to-a-secure-random-string

# Database URL for Local Users (SQLite default)
# DATABASE_URL=sqlite:///local_users.db

# --- Active Directory (LDAP) Configuration ---
ENABLE_AD_AUTH=True
# Assuming the domain controller is reachable at this address.
# You might need to use an IP address if DNS is not configured.
LDAP_SERVER=ldap://alkhairsoft.com
# Example Bind DN. Update 'ServiceAccount' with the actual username.
LDAP_BIND_DN=CN=ldap-services,CN=Users,DC=alkhairsoft,DC=com
# Update with the actual password for the service account
LDAP_BIND_PASSWORD=1234@abcd
LDAP_SEARCH_BASE=DC=alkhairsoft,DC=com

# --- MinIO Object Storage Configuration ---
ENABLE_MINIO=True
MINIO_ENDPOINT=play.min.io:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
# Set to False if MinIO is running on HTTP (local/dev)
MINIO_SECURE=True  

# --- Email (Zimbra/SMTP) Configuration ---
ENABLE_EMAIL=True
SMTP_SERVER=mail.alkhairsoft.com
SMTP_PORT=587
SMTP_USERNAME=your_email@alkhairsoft.com
SMTP_PASSWORD=your_email_password
SMTP_USE_TLS=True
SMTP_DEFAULT_SENDER=noreply@alkhairsoft.com
