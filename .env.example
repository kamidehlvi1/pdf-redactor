
# Secret Key for Flask Session Security
SECRET_KEY=change-this-to-a-secure-random-string

# Database URL for Local Users (SQLite default)
# DATABASE_URL=sqlite:///local_users.db

# --- Active Directory (LDAP) Configuration ---
ENABLE_AD_AUTH=True
LDAP_SERVER=ldap://your-ad-server.com
LDAP_BIND_DN=CN=ServiceAccount,CN=Users,DC=example,DC=com
LDAP_BIND_PASSWORD=your_service_account_password
LDAP_SEARCH_BASE=DC=example,DC=com

# --- MinIO Object Storage Configuration ---
ENABLE_MINIO=True
MINIO_ENDPOINT=play.min.io:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
# Set to False if MinIO is running on HTTP (local/dev)
MINIO_SECURE=True  

# --- Email (Zimbra/SMTP) Configuration ---
ENABLE_EMAIL=True
SMTP_SERVER=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_USE_TLS=True
SMTP_DEFAULT_SENDER=noreply@example.com
